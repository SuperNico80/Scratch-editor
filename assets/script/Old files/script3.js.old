"use strict";


/* =========================================================
   CONFIG
========================================================= */

const SVG_ROOT =
    "../assets/img/svg/blocks/";

const SNAP_SIZE =
    16;

const SNAP_DISTANCE =
    24;

const BLOCK_GAP =
    0;


/* =========================================================
   STATE
========================================================= */

const state = {

    languages: {

        html: {

            id: "html",

            name: "HTML",

            categories: {

                headers: {

                    id: "headers",

                    name: "Headers",

                    color: "#E44D26",

                    blocks: {

                        Settypeto: {

                            id: "Settypeto",

                            name: "Set type",

                            svgId: "Settypeto",

                            action: "{dropdown1}",

                            isC: false,

                            dataSrc: null,

                            options: [
                                "<!doctype html>"
                            ],

                            dropdowns: [

                                {

                                    dropdown: 1,

                                    options: [

                                        {
                                            name: "<!doctype html>",
                                            action: "<!doctype html>",
                                            value: "<!doctype html>"
                                        }

                                    ]

                                }

                            ],

                            inputs: []

                        },


                        Html: {

                            id: "Html",

                            name: "HTML",

                            svgId: "Html",

                            action:
                                '<html lang="{dropdown1}">',

                            isC: true,

                            dataSrc: null,

                            options: [
                                "en",
                                "es"
                            ],

                            dropdowns: [

                                {

                                    dropdown: 1,

                                    options: [

                                        {
                                            name: "en",
                                            action: "en",
                                            value: "en"
                                        },

                                        {
                                            name: "es",
                                            action: "es",
                                            value: "es"
                                        }

                                    ]

                                }

                            ],

                            inputs: []

                        },


                        Head: {

                            id: "Head",

                            name: "Head",

                            svgId: "Head",

                            action: "<head>",

                            isC: true,

                            dataSrc: null,

                            options: [],

                            dropdowns: [],

                            inputs: []

                        },
                        Name: {
                            id: "Name",
                            name: "Name",
                            svgId: "Name",
                            action: "<title>",
                            isC: true,
                            dataSrc: null,
                            options: [],
                            dropdowns: [],
                            inputs: []
                        },
                        Text: {
                            id: "Text",
                            name: "Text",
                            svgId: "Text",
                            action: "{input1}",
                            isC: false,
                            dataSrc: null,
                            options: [],
                            dropdowns: [],
                            inputs: [
                                {
                                    index: 1,
                                    name: "Text",
                                    type: "string",
                                    default: ""
                                }
                            ]
                        }

                    }

                }

            }

        },


        javascript: {

            id: "javascript",

            name: "JavaScript",

            categories: {}

        },


        css: {

            id: "css",

            name: "CSS",

            categories: {}

        }

    },


    currentLanguage:
        "html",

    selectedBlock:
        null,

    workspaceBlocks:
        [],

    nextWorkspaceId:
        1

};


/* =========================================================
   DOM
========================================================= */

const languageSelect =
    document.getElementById(
        "languageSelect"
    );

const categories =
    document.getElementById(
        "categories"
    );

const workspace =
    document.getElementById(
        "workspace"
    );

const workspaceEmpty =
    document.getElementById(
        "workspaceEmpty"
    );

const codeOutput =
    document.getElementById(
        "codeOutput"
    );

const previewContainer =
    document.getElementById(
        "previewContainer"
    );

const htmlPreview =
    document.getElementById(
        "htmlPreview"
    );


/* =========================================================
   SHORTCUT
========================================================= */

function $(id) {

    return document.getElementById(
        id
    );

}


/* =========================================================
   ID
========================================================= */

function normalizeId(value) {

    return String(
        value || ""
    )
        .trim()
        .replace(
            /\s+/g,
            "_"
        );

}


/* =========================================================
   CURRENT LANGUAGE
========================================================= */

function getCurrentLanguage() {

    return state.languages[
        state.currentLanguage
    ];

}


/* =========================================================
   CURRENT CATEGORY
========================================================= */

function getCurrentCategory() {

    const language =
        getCurrentLanguage();

    if (!language) {

        return null;

    }

    const ids =
        Object.keys(
            language.categories
        );

    if (!ids.length) {

        return null;

    }

    return language.categories[
        ids[0]
    ];

}


/* =========================================================
   SVG SOURCE
========================================================= */

function getSvgSource(
    block,
    languageId,
    categoryId
) {

    if (
        block.dataSrc &&
        String(block.dataSrc).trim()
    ) {

        return (
            "data:image/svg+xml;charset=utf-8," +
            encodeURIComponent(
                block.dataSrc
            )
        );

    }

    const svgId =
        block.svgId ||
        block.id;

    return (
        SVG_ROOT +
        encodeURIComponent(
            languageId
        ) +
        "/" +
        encodeURIComponent(
            categoryId
        ) +
        "/" +
        encodeURIComponent(
            svgId
        ) +
        ".svg"
    );

}


/* =========================================================
   LANGUAGE SELECT
========================================================= */

function renderLanguageSelect() {

    languageSelect.innerHTML =
        "";

    Object.values(
        state.languages
    )
        .forEach(
            language => {

                const option =
                    document.createElement(
                        "option"
                    );

                option.value =
                    language.id;

                option.textContent =
                    language.name;

                languageSelect.appendChild(
                    option
                );

            }
        );

    languageSelect.value =
        state.currentLanguage;

}


/* =========================================================
   PALETTE
========================================================= */

function renderPalette() {

    categories.innerHTML =
        "";

    const language =
        getCurrentLanguage();

    if (!language) {

        return;

    }

    Object.values(
        language.categories
    )
        .forEach(
            category => {

                const categoryElement =
                    document.createElement(
                        "div"
                    );

                categoryElement.className =
                    "category";

                const header =
                    document.createElement(
                        "div"
                    );

                header.className =
                    "categoryHeader";

                header.style.background =
                    category.color ||
                    "#555";

                header.textContent =
                    category.name;

                const blockContainer =
                    document.createElement(
                        "div"
                    );

                blockContainer.className =
                    "categoryBlocks";

                Object.values(
                    category.blocks
                )
                    .forEach(
                        block => {

                            blockContainer.appendChild(
                                createPaletteBlock(
                                    block,
                                    language.id,
                                    category.id
                                )
                            );

                        }
                    );

                categoryElement.appendChild(
                    header
                );

                categoryElement.appendChild(
                    blockContainer
                );

                categories.appendChild(
                    categoryElement
                );

            }
        );

}


/* =========================================================
   C BLOCK INDICATOR
========================================================= */

function createCBlockIndicator() {

    const indicator =
        document.createElement(
            "span"
        );

    indicator.className =
        "cBlockIndicator";

    indicator.textContent =
        "C";

    indicator.title =
        "C block: permite bloques dentro";

    indicator.setAttribute(
        "aria-label",
        "C block"
    );

    indicator.style.position =
        "absolute";

    indicator.style.top =
        "3px";

    indicator.style.right =
        "3px";

    indicator.style.zIndex =
        "100";

    indicator.style.display =
        "flex";

    indicator.style.alignItems =
        "center";

    indicator.style.justifyContent =
        "center";

    indicator.style.width =
        "16px";

    indicator.style.height =
        "16px";

    indicator.style.boxSizing =
        "border-box";

    indicator.style.borderRadius =
        "3px";

    indicator.style.fontFamily =
        "Arial, sans-serif";

    indicator.style.fontSize =
        "10px";

    indicator.style.fontWeight =
        "700";

    indicator.style.lineHeight =
        "1";

    indicator.style.background =
        "rgba(255,255,255,0.9)";

    indicator.style.color =
        "#333";

    indicator.style.border =
        "1px solid rgba(0,0,0,0.35)";

    indicator.style.boxShadow =
        "0 1px 2px rgba(0,0,0,0.25)";

    indicator.style.pointerEvents =
        "none";

    indicator.style.userSelect =
        "none";

    indicator.draggable =
        false;

    return indicator;

}


/* =========================================================
   PALETTE BLOCK
========================================================= */

function createPaletteBlock(
    block,
    languageId,
    categoryId
) {

    const element =
        document.createElement(
            "div"
        );

    element.className =
        "paletteBlock";

    element.draggable =
        true;

    element.dataset.blockId =
        block.id;

    element.dataset.language =
        languageId;

    element.dataset.category =
        categoryId;

    /*
        Solo se usa para colocar
        correctamente el indicador.
    */

    if (block.isC) {

        element.style.position =
            "relative";

    }

    const image =
        document.createElement(
            "img"
        );

    image.className =
        "blockSvg";

    image.src =
        getSvgSource(
            block,
            languageId,
            categoryId
        );

    image.alt =
        block.name ||
        block.id;

    image.draggable =
        false;

    element.appendChild(
        image
    );

    if (block.isC) {

        element.appendChild(
            createCBlockIndicator()
        );

    }

    element.addEventListener(
        "dragstart",
        event => {

            const payload = {

                blockId:
                    block.id,

                language:
                    languageId,

                category:
                    categoryId

            };

            event.dataTransfer.effectAllowed =
                "copy";

            event.dataTransfer.setData(
                "application/x-scratch-block",
                JSON.stringify(
                    payload
                )
            );

            event.dataTransfer.setData(
                "text/plain",
                JSON.stringify(
                    payload
                )
            );

        }
    );

    element.addEventListener(
        "dblclick",
        () => {

            addBlockToWorkspace(
                block,
                languageId,
                categoryId,
                32,
                32
            );

        }
    );

    return element;

}


/* =========================================================
   WORKSPACE DRAGOVER
========================================================= */

workspace.addEventListener(
    "dragover",
    event => {

        event.preventDefault();

        event.dataTransfer.dropEffect =
            "copy";

        workspace.classList.add(
            "dropTarget"
        );

    }
);


/* =========================================================
   WORKSPACE DRAGLEAVE
========================================================= */

workspace.addEventListener(
    "dragleave",
    event => {

        if (
            !workspace.contains(
                event.relatedTarget
            )
        ) {

            workspace.classList.remove(
                "dropTarget"
            );

        }

    }
);


/* =========================================================
   WORKSPACE DROP
========================================================= */

workspace.addEventListener(
    "drop",
    event => {

        event.preventDefault();

        workspace.classList.remove(
            "dropTarget"
        );

        let raw =
            event.dataTransfer.getData(
                "application/x-scratch-block"
            );

        if (!raw) {

            raw =
                event.dataTransfer.getData(
                    "text/plain"
                );

        }

        if (!raw) {

            return;

        }

        let data;

        try {

            data =
                JSON.parse(
                    raw
                );

        }

        catch {

            return;

        }

        const language =
            state.languages[
                data.language
            ];

        if (!language) {

            return;

        }

        const category =
            language.categories[
                data.category
            ];

        if (!category) {

            return;

        }

        const block =
            category.blocks[
                data.blockId
            ];

        if (!block) {

            return;

        }

        /*
            Primero comprobamos si se soltó
            dentro de un C block.
        */

        const parent =
            findCBlockAtPoint(
                event.clientX,
                event.clientY,
                null
            );

        if (parent) {

            const rect =
                parent.cBody.getBoundingClientRect();

            const x =
                Math.max(
                    0,
                    Math.round(
                        (
                            event.clientX -
                            rect.left -
                            8
                        ) /
                        SNAP_SIZE
                    ) *
                    SNAP_SIZE
                );

            const y =
                Math.max(
                    0,
                    Math.round(
                        (
                            event.clientY -
                            rect.top -
                            8
                        ) /
                        SNAP_SIZE
                    ) *
                    SNAP_SIZE
                );

            addBlockToWorkspace(
                block,
                data.language,
                data.category,
                x,
                y,
                parent
            );

            return;

        }

        /*
            Bloque raíz.
        */

        const rect =
            workspace.getBoundingClientRect();

        const x =
            event.clientX -
            rect.left +
            workspace.scrollLeft;

        const y =
            event.clientY -
            rect.top +
            workspace.scrollTop;

        const snapped =
            snapPosition(
                x,
                y
            );

        addBlockToWorkspace(
            block,
            data.language,
            data.category,
            snapped.x,
            snapped.y,
            null
        );

    }
);


/* =========================================================
   SNAP POSITION
========================================================= */

function snapPosition(
    x,
    y
) {

    let resultX =
        Math.round(
            x /
            SNAP_SIZE
        ) *
        SNAP_SIZE;

    let resultY =
        Math.round(
            y /
            SNAP_SIZE
        ) *
        SNAP_SIZE;

    for (
        const existing of
        getRootBlocks()
    ) {

        if (
            !existing.element
        ) {

            continue;

        }

        const dx =
            Math.abs(
                resultX -
                existing.x
            );

        if (
            dx >
            SNAP_DISTANCE
        ) {

            continue;

        }

        const height =
            existing.element.offsetHeight;

        const possibleY =
            existing.y +
            height +
            BLOCK_GAP;

        if (
            Math.abs(
                resultY -
                possibleY
            ) <=
            SNAP_DISTANCE
        ) {

            resultX =
                existing.x;

            resultY =
                Math.round(
                    possibleY /
                    SNAP_SIZE
                ) *
                SNAP_SIZE;

        }

    }

    return {

        x:
            Math.max(
                0,
                resultX
            ),

        y:
            Math.max(
                0,
                resultY
            )

    };

}


/* =========================================================
   ADD WORKSPACE BLOCK
========================================================= */

function addBlockToWorkspace(
    block,
    languageId,
    categoryId,
    x,
    y,
    parent = null
) {

    if (
        !block ||
        typeof block !==
        "object"
    ) {

        console.error(
            "Invalid block:",
            block
        );

        return null;

    }

    if (
        !Array.isArray(
            block.inputs
        )
    ) {

        block.inputs =
            [];

    }

    if (
        !Array.isArray(
            block.dropdowns
        )
    ) {

        block.dropdowns =
            [];

    }

    const instance = {

        uid:
            "workspaceBlock_" +
            state.nextWorkspaceId++,

        blockId:
            block.id,

        language:
            languageId,

        category:
            categoryId,

        x:
            Number(x) ||
            0,

        y:
            Number(y) ||
            0,

        values: {},

        dropdownValues: {},

        children: [],

        parent:
            parent ||
            null,

        element:
            null,

        cBody:
            null,

        cHint:
            null,

        isC:
            Boolean(
                block.isC
            )

    };

    /*
        INPUTS
    */

    block.inputs.forEach(
        (
            input,
            index
        ) => {

            const key =
                "input" +
                (
                    index +
                    1
                );

            let value;

            if (
                input.defaultValue !==
                undefined
            ) {

                value =
                    input.defaultValue;

            }

            else if (
                input.default !==
                undefined
            ) {

                value =
                    input.default;

            }

            else {

                value =
                    getDefaultInputValue(
                        input.type
                    );

            }

            instance.values[key] =
                convertInputValue(
                    value,
                    input.type
                );

        }
    );

    /*
        DROPDOWNS
    */

    block.dropdowns.forEach(
        dropdown => {

            const first =
                dropdown.options &&
                dropdown.options[0];

            instance.dropdownValues[
                "dropdown" +
                dropdown.dropdown
            ] =
                first
                    ? first.value
                    : "";

        }
    );

    state.workspaceBlocks.push(
        instance
    );

    if (parent) {

        parent.children.push(
            instance
        );

    }

    const element =
        createWorkspaceElement(
            instance,
            block
        );

    instance.element =
        element;

    if (
        parent &&
        parent.cBody
    ) {

        parent.cBody.appendChild(
            element
        );

    }

    else {

        workspace.appendChild(
            element
        );

    }

    selectWorkspaceBlock(
        instance
    );

    updateContainerLayout(
        parent
    );

    updateWorkspaceEmpty();

    updateCode();

    return instance;

}


/* =========================================================
   CREATE WORKSPACE ELEMENT
========================================================= */

function createWorkspaceElement(
    instance,
    block
) {

    const wrapper =
        document.createElement(
            "div"
        );

    wrapper.className =
        "workspaceBlock";

    if (block.isC) {

        wrapper.classList.add(
            "cBlock"
        );

    }

    wrapper.dataset.uid =
        instance.uid;

    wrapper.style.left =
        instance.x +
        "px";

    wrapper.style.top =
        instance.y +
        "px";

    wrapper.style.position =
        "absolute";

    wrapper.style.boxSizing =
        "border-box";


    /*
        SVG
    */

    const image =
        document.createElement(
            "img"
        );

    image.className =
        "blockSvg";

    image.src =
        getSvgSource(
            block,
            instance.language,
            instance.category
        );

    image.alt =
        block.name ||
        block.id;

    image.draggable =
        false;

    wrapper.appendChild(
        image
    );


    /*
        C INDICATOR
    */

    if (block.isC) {

        wrapper.appendChild(
            createCBlockIndicator()
        );

    }


    /*
        INPUTS
    */

    if (
        Array.isArray(
            block.inputs
        ) &&
        block.inputs.length
    ) {

        const inputContainer =
            document.createElement(
                "div"
            );

        inputContainer.className =
            "blockInputs";

        block.inputs.forEach(
            (
                input,
                index
            ) => {

                const number =
                    index +
                    1;

                const row =
                    document.createElement(
                        "span"
                    );

                row.className =
                    "blockInputRow";

                const label =
                    document.createElement(
                        "span"
                    );

                label.className =
                    "inputLabel";

                label.textContent =
                    input.label ||
                    input.name ||
                    "Input " +
                    number;

                const control =
                    createBlockInput(
                        input,
                        instance,
                        number
                    );

                row.appendChild(
                    label
                );

                row.appendChild(
                    control
                );

                inputContainer.appendChild(
                    row
                );

            }
        );

        wrapper.appendChild(
            inputContainer
        );

    }


    /*
        DROPDOWNS
    */

    if (
        Array.isArray(
            block.dropdowns
        ) &&
        block.dropdowns.length
    ) {

        const dropdownContainer =
            document.createElement(
                "div"
            );

        dropdownContainer.className =
            "blockDropdowns";

        block.dropdowns.forEach(
            dropdown => {

                const select =
                    document.createElement(
                        "select"
                    );

                select.className =
                    "blockDropdown";

                const key =
                    "dropdown" +
                    dropdown.dropdown;

                (
                    dropdown.options ||
                    []
                )
                    .forEach(
                        option => {

                            const item =
                                document.createElement(
                                    "option"
                                );

                            item.value =
                                option.value ??
                                "";

                            item.textContent =
                                option.name ??
                                option.value ??
                                "";

                            select.appendChild(
                                item
                            );

                        }
                    );

                select.value =
                    instance.dropdownValues[
                        key
                    ] ??
                    "";

                select.addEventListener(
                    "change",
                    () => {

                        instance.dropdownValues[
                            key
                        ] =
                            select.value;

                        updateCode();

                    }
                );

                dropdownContainer.appendChild(
                    select
                );

            }
        );

        wrapper.appendChild(
            dropdownContainer
        );

    }


    /*
        C BLOCK BODY
    */

    if (block.isC) {

        const body =
            document.createElement(
                "div"
            );

        body.className =
            "cBlockBody";

        body.dataset.parentUid =
            instance.uid;

        body.style.position =
            "relative";

        body.style.minHeight =
            "28px";

        body.style.boxSizing =
            "border-box";

        body.style.marginTop =
            "4px";

        body.style.marginBottom =
            "4px";

        body.style.padding =
            "4px 0";

        body.style.width =
            "100%";

        body.style.display =
            "block";


        const hint =
            document.createElement(
                "div"
            );

        hint.className =
            "cBlockDropHint";

        hint.textContent =
            "Suelta bloques aquí";

        hint.style.pointerEvents =
            "none";

        hint.style.opacity =
            "0.55";

        hint.style.fontSize =
            "11px";

        hint.style.padding =
            "4px 8px";

        body.appendChild(
            hint
        );

        instance.cBody =
            body;

        instance.cHint =
            hint;

        wrapper.appendChild(
            body
        );

    }


    /*
        MOUSE DOWN
    */

    wrapper.addEventListener(
        "mousedown",
        event => {

            if (
                event.target.closest(
                    "input, select, textarea, button"
                )
            ) {

                return;

            }

            /*
                El evento del hijo no debe
                iniciar también el arrastre
                del C block padre.
            */

            event.stopPropagation();

            selectWorkspaceBlock(
                instance
            );

            startWorkspaceDrag(
                event,
                instance,
                wrapper
            );

        }
    );


    /*
        CLICK
    */

    wrapper.addEventListener(
        "click",
        event => {

            if (
                event.target.closest(
                    "input, select, textarea, button"
                )
            ) {

                return;

            }

            event.stopPropagation();

            selectWorkspaceBlock(
                instance
            );

        }
    );


    return wrapper;

}


/* =========================================================
   INPUT CREATION
========================================================= */

function createBlockInput(
    input,
    instance,
    number
) {

    let control;


    if (
        input.type ===
        "boolean"
    ) {

        control =
            document.createElement(
                "select"
            );

        control.className =
            "blockBoolean";


        const trueOption =
            document.createElement(
                "option"
            );

        trueOption.value =
            "true";

        trueOption.textContent =
            "true";


        const falseOption =
            document.createElement(
                "option"
            );

        falseOption.value =
            "false";

        falseOption.textContent =
            "false";


        control.appendChild(
            trueOption
        );

        control.appendChild(
            falseOption
        );

        control.value =
            String(
                instance.values[
                    "input" +
                    number
                ]
            );

    }

    else {

        control =
            document.createElement(
                "input"
            );

        control.className =
            "blockInput";

        if (
            input.type ===
            "number"
        ) {

            control.type =
                "number";

            control.step =
                "any";

        }

        else {

            control.type =
                "text";

        }

        control.value =
            instance.values[
                "input" +
                number
            ] ??
            "";

    }


    control.dataset.input =
        "input" +
        number;


    control.addEventListener(
        "input",
        () => {

            let value =
                control.value;

            if (
                input.type ===
                "number"
            ) {

                value =
                    value ===
                    ""
                        ? ""
                        : Number(
                            value
                        );

            }

            else if (
                input.type ===
                "boolean"
            ) {

                value =
                    value ===
                    "true";

            }

            instance.values[
                "input" +
                number
            ] =
                value;

            updateCode();

        }
    );


    return control;

}


/* =========================================================
   DEFAULT INPUT
========================================================= */

function getDefaultInputValue(
    type
) {

    if (
        type ===
        "boolean"
    ) {

        return true;

    }

    if (
        type ===
        "number"
    ) {

        return 0;

    }

    return "";

}


/* =========================================================
   WORKSPACE DRAG
========================================================= */

function startWorkspaceDrag(
    event,
    instance,
    element
) {

    event.preventDefault();

    const elementRect =
        element.getBoundingClientRect();

    const pointerOffsetX =
        event.clientX -
        elementRect.left;

    const pointerOffsetY =
        event.clientY -
        elementRect.top;


    function move(
        moveEvent
    ) {

        const parentBody =
            instance.parent &&
            instance.parent.cBody
                ? instance.parent.cBody
                : null;

        const rect =
            parentBody
                ? parentBody.getBoundingClientRect()
                : workspace.getBoundingClientRect();

        const scrollX =
            parentBody
                ? parentBody.scrollLeft
                : workspace.scrollLeft;

        const scrollY =
            parentBody
                ? parentBody.scrollTop
                : workspace.scrollTop;


        let x =
            moveEvent.clientX -
            rect.left +
            scrollX -
            pointerOffsetX;

        let y =
            moveEvent.clientY -
            rect.top +
            scrollY -
            pointerOffsetY;


        x =
            Math.round(
                x /
                SNAP_SIZE
            ) *
            SNAP_SIZE;

        y =
            Math.round(
                y /
                SNAP_SIZE
            ) *
            SNAP_SIZE;


        const snapped =
            snapExistingBlock(
                instance,
                x,
                y,
                instance.parent
            );


        instance.x =
            snapped.x;

        instance.y =
            snapped.y;


        element.style.left =
            instance.x +
            "px";

        element.style.top =
            instance.y +
            "px";


        updateContainerLayout(
            instance.parent
        );

    }


    function up(
        upEvent
    ) {

        document.removeEventListener(
            "mousemove",
            move
        );

        document.removeEventListener(
            "mouseup",
            up
        );


        const targetParent =
            findCBlockAtPoint(
                upEvent.clientX,
                upEvent.clientY,
                instance
            );


        reparentWorkspaceBlock(
            instance,
            targetParent,
            upEvent.clientX,
            upEvent.clientY,
            pointerOffsetX,
            pointerOffsetY
        );


        updateCode();

    }


    document.addEventListener(
        "mousemove",
        move
    );

    document.addEventListener(
        "mouseup",
        up
    );

}


/* =========================================================
   SNAP EXISTING BLOCK
========================================================= */

function snapExistingBlock(
    moving,
    x,
    y,
    parent = null
) {

    let resultX =
        Math.max(
            0,
            x
        );

    let resultY =
        Math.max(
            0,
            y
        );


    const siblings =
        state.workspaceBlocks.filter(
            block => {

                return (
                    block !==
                    moving &&
                    (block.parent || null) ===
                    (parent || null) &&
                    block.element
                );

            }
        );


    for (
        const other of
        siblings
    ) {

        const movingWidth =
            moving.element.offsetWidth;

        const movingHeight =
            moving.element.offsetHeight;

        const otherWidth =
            other.element.offsetWidth;

        const otherHeight =
            other.element.offsetHeight;


        /*
            Encima
        */

        if (
            Math.abs(
                resultY +
                movingHeight -
                other.y
            ) <=
            SNAP_DISTANCE &&
            Math.abs(
                resultX -
                other.x
            ) <=
            SNAP_DISTANCE
        ) {

            resultX =
                other.x;

            resultY =
                other.y -
                movingHeight -
                BLOCK_GAP;

        }


        /*
            Debajo
        */

        if (
            Math.abs(
                resultY -
                (
                    other.y +
                    otherHeight
                )
            ) <=
            SNAP_DISTANCE &&
            Math.abs(
                resultX -
                other.x
            ) <=
            SNAP_DISTANCE
        ) {

            resultX =
                other.x;

            resultY =
                other.y +
                otherHeight +
                BLOCK_GAP;

        }


        /*
            Izquierda
        */

        if (
            Math.abs(
                resultX +
                movingWidth -
                other.x
            ) <=
            SNAP_DISTANCE &&
            rangesOverlap(
                resultY,
                resultY +
                movingHeight,
                other.y,
                other.y +
                otherHeight
            )
        ) {

            resultX =
                other.x -
                movingWidth -
                BLOCK_GAP;

        }


        /*
            Derecha
        */

        if (
            Math.abs(
                resultX -
                (
                    other.x +
                    otherWidth
                )
            ) <=
            SNAP_DISTANCE &&
            rangesOverlap(
                resultY,
                resultY +
                movingHeight,
                other.y,
                other.y +
                otherHeight
            )
        ) {

            resultX =
                other.x +
                otherWidth +
                BLOCK_GAP;

        }

    }


    return {

        x:
            Math.max(
                0,
                Math.round(
                    resultX /
                    SNAP_SIZE
                ) *
                SNAP_SIZE
            ),

        y:
            Math.max(
                0,
                Math.round(
                    resultY /
                    SNAP_SIZE
                ) *
                SNAP_SIZE
            )

    };

}


/* =========================================================
   RANGE OVERLAP
========================================================= */

function rangesOverlap(
    a1,
    a2,
    b1,
    b2
) {

    return (
        a1 <
        b2 &&
        a2 >
        b1
    );

}


/* =========================================================
   ROOT BLOCKS
========================================================= */

function getRootBlocks() {

    return state.workspaceBlocks
        .filter(
            block =>
                !block.parent
        );

}


/* =========================================================
   DESCENDANT
========================================================= */

function isDescendantOf(
    instance,
    possibleAncestor
) {

    let current =
        instance;

    while (current) {

        if (
            current ===
            possibleAncestor
        ) {

            return true;

        }

        current =
            current.parent ||
            null;

    }

    return false;

}


/* =========================================================
   FIND C BLOCK
========================================================= */

function findCBlockAtPoint(
    clientX,
    clientY,
    moving
) {

    const candidates =
        state.workspaceBlocks
            .filter(
                block =>
                    block !==
                    moving &&
                    block.isC &&
                    block.cBody
            )
            .filter(
                block =>
                    !isDescendantOf(
                        block,
                        moving
                    )
            );


    for (
        let i =
            candidates.length -
            1;

        i >= 0;

        i--
    ) {

        const body =
            candidates[i].cBody;

        const rect =
            body.getBoundingClientRect();


        if (
            clientX >=
            rect.left &&
            clientX <=
            rect.right &&
            clientY >=
            rect.top &&
            clientY <=
            rect.bottom
        ) {

            return candidates[i];

        }

    }


    return null;

}


/* =========================================================
   REPARENT
========================================================= */

function reparentWorkspaceBlock(
    instance,
    newParent,
    clientX,
    clientY,
    offsetX,
    offsetY
) {

    const oldParent =
        instance.parent ||
        null;


    /*
        No permitir meter un C block
        dentro de sí mismo.
    */

    if (
        newParent ===
        instance ||
        isDescendantOf(
            newParent,
            instance
        )
    ) {

        newParent =
            oldParent;

    }


    if (
        oldParent ===
        newParent
    ) {

        return;

    }


    /*
        Quitar del padre anterior.
    */

    if (oldParent) {

        oldParent.children =
            oldParent.children.filter(
                child =>
                    child !==
                    instance
            );

    }


    instance.parent =
        newParent ||
        null;


    /*
        Nuevo padre.
    */

    if (newParent) {

        if (
            !newParent.children.includes(
                instance
            )
        ) {

            newParent.children.push(
                instance
            );

        }


        if (
            instance.element.parentNode !==
            newParent.cBody
        ) {

            newParent.cBody.appendChild(
                instance.element
            );

        }


        const rect =
            newParent.cBody.getBoundingClientRect();


        instance.x =
            Math.max(
                0,
                Math.round(
                    (
                        clientX -
                        rect.left -
                        offsetX
                    ) /
                    SNAP_SIZE
                ) *
                SNAP_SIZE
            );


        instance.y =
            Math.max(
                0,
                Math.round(
                    (
                        clientY -
                        rect.top -
                        offsetY
                    ) /
                    SNAP_SIZE
                ) *
                SNAP_SIZE
            );

    }


    /*
        Volver a raíz.
    */

    else {

        if (
            instance.element.parentNode !==
            workspace
        ) {

            workspace.appendChild(
                instance.element
            );

        }


        const rect =
            workspace.getBoundingClientRect();


        instance.x =
            Math.max(
                0,
                Math.round(
                    (
                        clientX -
                        rect.left +
                        workspace.scrollLeft -
                        offsetX
                    ) /
                    SNAP_SIZE
                ) *
                SNAP_SIZE
            );


        instance.y =
            Math.max(
                0,
                Math.round(
                    (
                        clientY -
                        rect.top +
                        workspace.scrollTop -
                        offsetY
                    ) /
                    SNAP_SIZE
                ) *
                SNAP_SIZE
            );

    }


    instance.element.style.left =
        instance.x +
        "px";

    instance.element.style.top =
        instance.y +
        "px";


    updateContainerLayout(
        oldParent
    );

    updateContainerLayout(
        newParent
    );

}


/* =========================================================
   CONTAINER LAYOUT
========================================================= */

function updateContainerLayout(
    parent
) {

    if (
        !parent ||
        !parent.cBody
    ) {

        return;

    }


    const children =
        parent.children ||
        [];


    let maxBottom =
        28;


    children.forEach(
        child => {

            if (
                !child.element
            ) {

                return;

            }


            const bottom =
                child.y +
                child.element.offsetHeight +
                4;


            if (
                bottom >
                maxBottom
            ) {

                maxBottom =
                    bottom;

            }

        }
    );


    parent.cBody.style.minHeight =
        Math.max(
            28,
            maxBottom
        ) +
        "px";


    if (parent.cHint) {

        parent.cHint.style.display =
            children.length
                ? "none"
                : "block";

    }

}


/* =========================================================
   SELECT
========================================================= */

function selectWorkspaceBlock(
    instance
) {

    state.workspaceBlocks
        .forEach(
            block => {

                if (
                    block.element
                ) {

                    block.element
                        .classList
                        .remove(
                            "selected"
                        );

                }

            }
        );


    state.selectedBlock =
        instance ||
        null;


    if (
        instance &&
        instance.element
    ) {

        instance.element
            .classList
            .add(
                "selected"
            );

    }

}


/* =========================================================
   DELETE BLOCK
========================================================= */

function removeWorkspaceBlock(
    instance
) {

    if (!instance) {

        return;

    }


    /*
        Primero eliminar hijos.
    */

    const children =
        [
            ...(instance.children || [])
        ];


    children.forEach(
        child => {

            removeWorkspaceBlock(
                child
            );

        }
    );


    /*
        Quitar del padre.
    */

    if (instance.parent) {

        const parent =
            instance.parent;

        parent.children =
            parent.children.filter(
                child =>
                    child !==
                    instance
            );

        updateContainerLayout(
            parent
        );

    }


    /*
        Quitar DOM.
    */

    if (
        instance.element
    ) {

        instance.element.remove();

    }


    /*
        Quitar estado.
    */

    const index =
        state.workspaceBlocks.indexOf(
            instance
        );

    if (
        index !==
        -1
    ) {

        state.workspaceBlocks.splice(
            index,
            1
        );

    }

}


/* =========================================================
   DELETE BUTTON
========================================================= */

$("deleteSelectedButton")
    .addEventListener(
        "click",
        () => {

            const selected =
                state.selectedBlock;

            if (!selected) {

                return;

            }

            removeWorkspaceBlock(
                selected
            );

            state.selectedBlock =
                null;

            updateWorkspaceEmpty();

            updateCode();

        }
    );


/* =========================================================
   CLEAR
========================================================= */

$("clearButton")
    .addEventListener(
        "click",
        clearWorkspace
    );


function clearWorkspace() {

    state.workspaceBlocks
        .forEach(
            block => {

                if (
                    block.element
                ) {

                    block.element.remove();

                }

            }
        );

    state.workspaceBlocks.length =
        0;

    state.selectedBlock =
        null;

    updateWorkspaceEmpty();

    updateCode();

}


/* =========================================================
   EMPTY
========================================================= */

function updateWorkspaceEmpty() {

    workspaceEmpty.style.display =
        state.workspaceBlocks.length
            ? "none"
            : "flex";

}


/* =========================================================
   HTML TAG
========================================================= */

function resolveHtmlTag(
    instance
) {

    let tag =
        instance.values.tag ||
        instance.values.input1 ||
        instance.dropdownValues.tag ||
        "div";


    tag =
        String(
            tag
        )
            .trim()
            .replace(
                /^<|>$/g,
                ""
            );


    if (!tag) {

        tag =
            "div";

    }


    return tag;

}


/* =========================================================
   C BLOCK CODE
========================================================= */

function generateCBlockCode(
    openingCode,
    childCode,
    block,
    instance
) {

    const hasChildren =
        Boolean(
            childCode
        );


    let code =
        openingCode;


    /*
        <<etiqueta html>>
    */

    if (
        code.includes(
            "<<etiqueta html>>"
        ) ||
        code.includes(
            "</<etiqueta html>>"
        )
    ) {

        const tag =
            resolveHtmlTag(
                instance
            );


        code =
            code.replaceAll(
                "<<etiqueta html>>",
                "<" +
                tag +
                ">"
            );


        code =
            code.replaceAll(
                "</<etiqueta html>>",
                "</" +
                tag +
                ">"
            );


        if (
            !code.includes(
                "</" +
                tag +
                ">"
            )
        ) {

            code +=
                "\n</" +
                tag +
                ">";

        }


        code =
            code.replace(
                "{children}",
                hasChildren
                    ? "\n" +
                      childCode +
                      "\n"
                    : ""
            );


        /*
            Si no había {children},
            colocar hijos antes del cierre.
        */

        if (
            hasChildren &&
            !openingCode.includes(
                "{children}"
            )
        ) {

            const closing =
                "</" +
                tag +
                ">";

            code =
                code.replace(
                    closing,
                    "\n" +
                    childCode +
                    "\n" +
                    closing
                );

        }


        return code;

    }


    /*
        {}
    */

    if (
        code.includes(
            "{}"
        )
    ) {

        const parts =
            code.split(
                "{}"
            );


        const open =
            parts[0]
                .trimEnd() +
            " {";


        return (
            open +
            (
                hasChildren
                    ? "\n" +
                      childCode +
                      "\n"
                    : "\n"
            ) +
            "}"
        );

    }


    /*
        []
    */

    if (
        code.includes(
            "[]"
        )
    ) {

        const parts =
            code.split(
                "[]"
            );


        const open =
            parts[0]
                .trimEnd() +
            " [";


        return (
            open +
            (
                hasChildren
                    ? "\n" +
                      childCode +
                      "\n"
                    : "\n"
            ) +
            "]"
        );

    }


    /*
        end
    */

    if (
        /\bend\b/i.test(
            code
        )
    ) {

        const open =
            code
                .replace(
                    /\bend\b/ig,
                    ""
                )
                .trimEnd();


        return (
            open +
            (
                hasChildren
                    ? "\n" +
                      childCode +
                      "\n"
                    : "\n"
            ) +
            "end"
        );

    }


    /*
        :
    */

    if (
        /:\s*$/.test(
            code
        )
    ) {

        return (
            code.trimEnd() +
            (
                hasChildren
                    ? "\n" +
                      childCode
                    : ""
            )
        );

    }


    /*
        HTML normal.
    */

    const htmlOpen =
        code.match(
            /^\s*<([A-Za-z][A-Za-z0-9-]*)(\s[^>]*)?>\s*$/
        );


    if (
        htmlOpen &&
        !/\/\s*>$/.test(
            code
        )
    ) {

        const tag =
            htmlOpen[1];


        return (
            code +
            (
                hasChildren
                    ? "\n" +
                      childCode +
                      "\n"
                    : "\n"
            ) +
            "</" +
            tag +
            ">"
        );

    }


    return code.replace(
        "{children}",
        childCode
    );

}


/* =========================================================
   GENERATE BLOCK CODE
========================================================= */

function generateBlockCode(
    instance
) {

    const language =
        state.languages[
            instance.language
        ];

    if (!language) {

        return "";

    }


    const category =
        language.categories[
            instance.category
        ];

    if (!category) {

        return "";

    }


    const block =
        category.blocks[
            instance.blockId
        ];

    if (!block) {

        return "";

    }


    let code =
        block.action ||
        "";


    /*
        DROPDOWNS
    */

    if (
        Array.isArray(
            block.dropdowns
        )
    ) {

        block.dropdowns.forEach(
            dropdown => {

                const key =
                    "dropdown" +
                    dropdown.dropdown;

                const selected =
                    instance.dropdownValues[
                        key
                    ];

                const option =
                    (
                        dropdown.options ||
                        []
                    )
                        .find(
                            item =>
                                String(
                                    item.value
                                ) ===
                                String(
                                    selected
                                )
                        );

                const value =
                    option
                        ? option.value
                        : selected;

                const name =
                    option
                        ? option.name
                        : value;

                const action =
                    option
                        ? option.action
                        : value;


                code =
                    code.replaceAll(
                        "{" +
                        key +
                        "}",
                        value ??
                        ""
                    );

                code =
                    code.replaceAll(
                        "{" +
                        key +
                        ".name}",
                        name ??
                        ""
                    );

                code =
                    code.replaceAll(
                        "{" +
                        key +
                        ".action}",
                        action ??
                        ""
                    );

                code =
                    code.replaceAll(
                        "{" +
                        key +
                        ".value}",
                        value ??
                        ""
                    );

            }
        );

    }


    /*
        INPUTS
    */

    if (
        Array.isArray(
            block.inputs
        )
    ) {

        block.inputs.forEach(
            (
                input,
                index
            ) => {

                const key =
                    "input" +
                    (
                        index +
                        1
                    );

                let value =
                    instance.values[
                        key
                    ];


                if (
                    input.type ===
                    "boolean"
                ) {

                    value =
                        Boolean(
                            value
                        );

                }


                if (
                    input.type ===
                    "number"
                ) {

                    if (
                        value ===
                        "" ||
                        value ===
                        null ||
                        value ===
                        undefined
                    ) {

                        value =
                            0;

                    }

                }


                if (
                    input.type ===
                    "string"
                ) {

                    if (
                        value ===
                        null ||
                        value ===
                        undefined
                    ) {

                        value =
                            "";

                    }

                }


                code =
                    code.replaceAll(
                        "{" +
                        key +
                        "}",
                        String(
                            value
                        )
                    );

            }
        );

    }


    /*
        CHILDREN
    */

    const childCode =
        (
            instance.children ||
            []
        )
            .slice()
            .sort(
                (
                    a,
                    b
                ) => {

                    if (
                        a.y !==
                        b.y
                    ) {

                        return (
                            a.y -
                            b.y
                        );

                    }

                    return (
                        a.x -
                        b.x
                    );

                }
            )
            .map(
                child =>
                    generateBlockCode(
                        child
                    )
            )
            .filter(
                Boolean
            )
            .join(
                "\n"
            );


    if (!block.isC) {

        return code
            .replaceAll(
                "{children}",
                childCode
            )
            .trim();

    }


    return generateCBlockCode(
        code,
        childCode,
        block,
        instance
    )
        .trim();

}


/* =========================================================
   UPDATE CODE
========================================================= */

function updateCode() {

    const blocks =
        getRootBlocks()
            .slice()
            .sort(
                (
                    a,
                    b
                ) => {

                    if (
                        a.y !==
                        b.y
                    ) {

                        return (
                            a.y -
                            b.y
                        );

                    }

                    return (
                        a.x -
                        b.x
                    );

                }
            );


    const lines =
        blocks.map(
            block =>
                generateBlockCode(
                    block
                )
        );


    const code =
        lines
            .filter(
                line =>
                    line !==
                    null &&
                    line !==
                    ""
            )
            .join(
                "\n"
            );


    codeOutput.textContent =
        code;


    updatePreview(
        code
    );

}


/* =========================================================
   PREVIEW
========================================================= */

function updatePreview(
    code
) {

    if (
        state.currentLanguage ===
        "html"
    ) {

        previewContainer.classList.add(
            "visible"
        );

        htmlPreview.srcdoc =
            code;

    }

    else {

        previewContainer.classList.remove(
            "visible"
        );

        htmlPreview.srcdoc =
            "";

    }

}


/* =========================================================
   COPY
========================================================= */

$("copyButton")
    .addEventListener(
        "click",
        async () => {

            const text =
                codeOutput.textContent;


            try {

                await navigator
                    .clipboard
                    .writeText(
                        text
                    );

            }

            catch {

                const textarea =
                    document.createElement(
                        "textarea"
                    );

                textarea.value =
                    text;

                document.body.appendChild(
                    textarea
                );

                textarea.select();

                document.execCommand(
                    "copy"
                );

                textarea.remove();

            }

        }
    );


/* =========================================================
   LANGUAGE CHANGE
========================================================= */

languageSelect.addEventListener(
    "change",
    () => {

        state.currentLanguage =
            languageSelect.value;

        state.selectedBlock =
            null;

        renderPalette();

        updateCode();

    }
);


/* =========================================================
   MODAL HELPERS
========================================================= */

function openModal(
    id
) {

    const modal =
        $(id);

    if (!modal) {

        return;

    }

    modal.classList.remove(
        "hidden"
    );

}


function closeModal(
    id
) {

    const modal =
        $(id);

    if (!modal) {

        return;

    }

    modal.classList.add(
        "hidden"
    );

}


/* =========================================================
   LANGUAGE MODAL
========================================================= */

$("addLanguageButton")
    .addEventListener(
        "click",
        () => {

            $("languageId").value =
                "";

            $("languageName").value =
                "";

            openModal(
                "languageModal"
            );

        }
    );


$("cancelLanguageButton")
    .addEventListener(
        "click",
        () => {

            closeModal(
                "languageModal"
            );

        }
    );


$("saveLanguageButton")
    .addEventListener(
        "click",
        () => {

            const id =
                normalizeId(
                    $("languageId").value
                );

            const name =
                $("languageName")
                    .value
                    .trim();


            if (
                !id ||
                !name
            ) {

                alert(
                    "Enter a language ID and name."
                );

                return;

            }


            if (
                state.languages[id]
            ) {

                alert(
                    "That language already exists."
                );

                return;

            }


            state.languages[id] = {

                id:
                    id,

                name:
                    name,

                categories:
                    {}

            };


            state.currentLanguage =
                id;


            renderLanguageSelect();

            renderPalette();

            updateCode();

            closeModal(
                "languageModal"
            );

        }
    );


/* =========================================================
   CATEGORY MODAL
========================================================= */

$("addCategoryButton")
