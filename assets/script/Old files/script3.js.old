/* =========================================================
   INPUT EDITOR
========================================================= */

let inputDefinitions =
    [];


function resetInputEditor() {

    inputDefinitions =
        [];

    renderInputEditor();

}


function renderInputEditor() {

    const container =
        $("inputEditorList");

    if (!container) {

        return;

    }

    container.innerHTML =
        "";


    inputDefinitions.forEach(
        (
            input,
            index
        ) => {

            const row =
                document.createElement(
                    "div"
                );

            row.className =
                "inputDefinition";


            /*
                TYPE
            */

            const type =
                document.createElement(
                    "select"
                );


            [
                "string",
                "boolean",
                "number"
            ]
                .forEach(
                    typeName => {

                        const option =
                            document.createElement(
                                "option"
                            );

                        option.value =
                            typeName;

                        option.textContent =
                            typeName;

                        option.selected =
                            input.type ===
                            typeName;

                        type.appendChild(
                            option
                        );

                    }
                );


            /*
                NAME
            */

            const name =
                document.createElement(
                    "input"
                );

            name.type =
                "text";

            name.placeholder =
                "Name";

            name.value =
                input.name ||
                "";


            /*
                DEFAULT
            */

            const defaultValue =
                document.createElement(
                    "input"
                );

            defaultValue.type =
                "text";

            defaultValue.placeholder =
                "Default value";

            defaultValue.value =
                input.defaultValue ??
                "";


            /*
                REMOVE
            */

            const remove =
                document.createElement(
                    "button"
                );

            remove.type =
                "button";

            remove.className =
                "removeInput";

            remove.textContent =
                "Remove";


            /*
                EVENTS
            */

            type.addEventListener(
                "change",
                () => {

                    input.type =
                        type.value;

                    input.defaultValue =
                        getDefaultInputValue(
                            input.type
                        );

                    renderInputEditor();

                }
            );


            name.addEventListener(
                "input",
                () => {

                    input.name =
                        name.value;

                }
            );


            defaultValue.addEventListener(
                "input",
                () => {

                    input.defaultValue =
                        convertInputValue(
                            defaultValue.value,
                            input.type
                        );

                }
            );


            remove.addEventListener(
                "click",
                () => {

                    inputDefinitions.splice(
                        index,
                        1
                    );

                    renderInputEditor();

                }
            );


            row.appendChild(
                type
            );

            row.appendChild(
                name
            );

            row.appendChild(
                defaultValue
            );

            row.appendChild(
                remove
            );

            container.appendChild(
                row
            );

        }
    );

}


/* =========================================================
   CONVERT INPUT
========================================================= */

function convertInputValue(
    value,
    type
) {

    if (
        type ===
        "boolean"
    ) {

        return (
            String(
                value
            )
                .toLowerCase() ===
            "true"
        );

    }


    if (
        type ===
        "number"
    ) {

        const number =
            Number(
                value
            );

        return Number.isFinite(
            number
        )
            ? number
            : 0;

    }


    return value;

}


/* =========================================================
   ADD INPUT
========================================================= */

$("addInputButton")
    .addEventListener(
        "click",
        () => {

            inputDefinitions.push({

                type:
                    "string",

                name:
                    "input" +
                    (
                        inputDefinitions.length +
                        1
                    ),

                defaultValue:
                    ""

            });

            renderInputEditor();

        }
    );


/* =========================================================
   DROPDOWN EDITOR
========================================================= */

$("blockDropdownCount")
    .addEventListener(
        "input",
        renderDropdownEditor
    );


function renderDropdownEditor() {

    const container =
        $("dropdownEditor");

    if (!container) {

        return;

    }

    container.innerHTML =
        "";


    let count =
        Number(
            $("blockDropdownCount")
                .value
        );


    if (
        !Number.isFinite(
            count
        ) ||
        count < 0
    ) {

        count =
            0;

    }


    for (
        let i =
            1;

        i <=
        count;

        i++
    ) {

        const box =
            document.createElement(
                "div"
            );

        box.className =
            "dropdownOption";


        const title =
            document.createElement(
                "div"
            );

        title.className =
            "dropdownTitle";

        title.textContent =
            "Dropdown " +
            i;


        const textarea =
            document.createElement(
                "textarea"
            );

        textarea.rows =
            3;

        textarea.dataset.dropdown =
            i;

        textarea.placeholder =
            "Option 1\nOption 2\nOption 3";


        box.appendChild(
            title
        );

        box.appendChild(
            textarea
        );

        container.appendChild(
            box
        );

    }

}


/* =========================================================
   BLOCK MODAL
========================================================= */

$("addBlockButton")
    .addEventListener(
        "click",
        () => {

            const category =
                getCurrentCategory();

            if (!category) {

                alert(
                    "Create a category first."
                );

                return;

            }

            resetBlockForm();

            openModal(
                "blockModal"
            );

        }
    );


function resetBlockForm() {

    $("blockId").value =
        "";

    $("blockSvgId").value =
        "";

    $("blockName").value =
        "";

    $("blockAction").value =
        "";

    $("blockDropdownCount").value =
        "0";

    $("blockIsC").checked =
        false;

    $("blockDataSrc").value =
        "";

    resetInputEditor();

    renderDropdownEditor();

}


/* =========================================================
   CANCEL BLOCK
========================================================= */

$("cancelBlockButton")
    .addEventListener(
        "click",
        () => {

            closeModal(
                "blockModal"
            );

        }
    );


/* =========================================================
   SAVE BLOCK
========================================================= */

$("saveBlockButton")
    .addEventListener(
        "click",
        saveBlock
    );


function saveBlock() {

    const language =
        getCurrentLanguage();

    const category =
        getCurrentCategory();


    if (
        !language ||
        !category
    ) {

        alert(
            "Create a category first."
        );

        return;

    }


    const id =
        normalizeId(
            $("blockId").value
        );

    const svgId =
        $("blockSvgId")
            .value
            .trim();

    const name =
        $("blockName")
            .value
            .trim();

    const action =
        $("blockAction")
            .value;

    const isC =
        $("blockIsC")
            .checked;

    const dataSrc =
        $("blockDataSrc")
            .value
            .trim();


    if (!id) {

        alert(
            "Enter a block ID."
        );

        return;

    }


    if (!name) {

        alert(
            "Enter a block name."
        );

        return;

    }


    if (
        !svgId &&
        !dataSrc
    ) {

        alert(
            "Enter an SVG file ID or data-src."
        );

        return;

    }


    if (
        category.blocks[id]
    ) {

        alert(
            "That block ID already exists."
        );

        return;

    }


    const inputs =
        inputDefinitions.map(
            (
                input,
                index
            ) => {

                return {

                    type:
                        input.type,

                    name:
                        input.name ||
                        "input" +
                        (
                            index +
                            1
                        ),

                    label:
                        input.name ||
                        "Input " +
                        (
                            index +
                            1
                        ),

                    defaultValue:
                        convertInputValue(
                            input.defaultValue,
                            input.type
                        )

                };

            }
        );


    const dropdowns =
        [];


    const count =
        Number(
            $("blockDropdownCount")
                .value
        );


    for (
        let i =
            1;

        i <=
        count;

        i++
    ) {

        const textarea =
            document.querySelector(
                '[data-dropdown="' +
                i +
                '"]'
            );

        const raw =
            textarea
                ? textarea.value
                : "";

        const lines =
            raw
                .split(
                    "\n"
                )
                .map(
                    value =>
                        value.trim()
                )
                .filter(
                    Boolean
                );


        dropdowns.push({

            dropdown:
                i,

            options:
                lines.map(
                    value => ({

                        name:
                            value,

                        action:
                            value,

                        value:
                            value

                    })
                )

        });

    }


    const block = {

        id:
            id,

        name:
            name,

        svgId:
            svgId,

        action:
            action,

        isC:
            isC,

        dataSrc:
            dataSrc ||
            null,

        inputs:
            inputs,

        dropdowns:
            dropdowns,

        options:
            dropdowns.length
                ? dropdowns[0]
                    .options
                    .map(
                        option =>
                            option.value
                    )
                : []

    };


    category.blocks[id] =
        block;


    renderPalette();

    closeModal(
        "blockModal"
    );

}


/* =========================================================
   INITIALIZE
========================================================= */

function initialize() {

    renderLanguageSelect();

    renderPalette();

    updateWorkspaceEmpty();

    updateCode();

}


initialize();


/* =========================================================
   PUBLIC API
========================================================= */

window.ScratchCodeEditor = {

    state,

    addBlockToWorkspace,

    updateCode,

    renderPalette,

    renderLanguageSelect,

    snapPosition

};