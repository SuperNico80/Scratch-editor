function setupCloneAndDrag(selector) {
  let activeElement = null;
  let offsetX = 0;
  let offsetY = 0;

  // 1. Detectar el clic inicial
  document.addEventListener('mousedown', (e) => {
    if (!e.target.matches(selector)) return;

    let targetToDrag = e.target;

    /* 
       SI EL ELEMENTO ES EL ORIGINAL (no está posicionado absolutamente aún),
       creamos un clon en su lugar y arrastramos el clon.
    */
    if (window.getComputedStyle(targetToDrag).position !== 'absolute') {
      const clone = targetToDrag.cloneNode(true);
      const rect = targetToDrag.getBoundingClientRect();
      
      // Configurar el clon con el z-index requerido
      clone.style.position = 'absolute';
      clone.style.left = `${rect.left + window.scrollX}px`;
      clone.style.top = `${rect.top + window.scrollY}px`;
      clone.style.zIndex = '10000';
      
      document.body.appendChild(clone);
      
      // Ahora nuestro objetivo a arrastrar pasa a ser el clon recién creado
      targetToDrag = clone;
    }

    // Activar el arrastre para el elemento (sea un clon viejo o el nuevo)
    activeElement = targetToDrag;
    activeElement.style.zIndex = '10000'; // Asegurar el z-index al interactuar

    const rect = activeElement.getBoundingClientRect();
    offsetX = e.clientX - rect.left;
    offsetY = e.clientY - rect.top;
    
    e.preventDefault(); // Evita selección de texto molesta
  });

  // 2. Mover el elemento activo por la pantalla
  document.addEventListener('mousemove', (e) => {
    if (!activeElement) return;

    activeElement.style.left = `${e.clientX + window.scrollX - offsetX}px`;
    activeElement.style.top = `${e.clientY + window.scrollY - offsetY}px`;
  });

  // 3. Soltar el elemento
  document.addEventListener('mouseup', () => {
    if (!activeElement) return;

    // Run the snap check right before clearing the active element
    const snappedTarget = snapScratchBlock(activeElement);
    
    if (snappedTarget) {
      console.log("Snapped to block:", snappedTarget);
      // Optional: Append the activeElement into the actual SVG logic structure here if needed
    }

    activeElement = null;
  });

}

